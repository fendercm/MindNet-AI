{
  "name": "mindnet-ai",
  "version": "1.0.0",
  "description": "MindNet AI - Interactive knowledge graph with AI analytics",
  "author": "Your Name",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.mindnet.ai",
    "productName": "MindNet AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    }
  },
  "dependencies": {
    "axios": "^1.x.x",
    "html-to-image": "^1.11.13",
    "react": "^18.x.x",
    "react-dom": "^18.x.x",
    "reactflow": "^11.x.x"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.x.x",
    "concurrently": "^8.x.x",
    "electron": "^28.x.x",
    "electron-builder": "^24.x.x",
    "vite": "^5.x.x",
    "wait-on": "^7.x.x"
  }
}
