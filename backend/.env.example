# MindNet AI — ключи для разработки (python -m uvicorn main:app).
# Собранное приложение .env не читает: ключи вводятся в окне «Настройки».
# Скопируйте в .env и заполните: copy .env.example .env

# Порядок провайдеров через запятую; пусто — все, для которых есть ключ
AI_MODELS=
AI_TIMEOUT=30

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Qwen через HuggingFace
HF_API_KEY=

# Опционально
DEEPSEEK_API_KEY=
GROK_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

# Прокси для запросов к AI (опционально)
USE_PROXY=false
PROXY_URL=

# Папка с базой и настройками (по умолчанию backend/data)
# MINDNET_DATA_DIR=
