# MindNet AI — пример конфигурации backend
# Скопируйте в .env и заполните: copy .env.example .env

# --- ИИ-провайдеры ---
GEMINI_API_KEY=ваш_ключ_gemini
AI_PRIMARY=gemini
AI_FALLBACK=qwen3
AI_TIMEOUT=30

# OpenAI-совместимый endpoint (опционально)
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Прокси (опционально) ---
USE_PROXY=false
PROXY_URL=

# --- Neo4j ---
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
